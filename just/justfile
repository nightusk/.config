[windows]
set shell := ["C:\\Program Files\\Git\\bin\\sh.exe", "-cu"]

git_hook_dir := "~/.config/git/hooks"
export GIT_HOOK_SCRIPT := '''
  #!/bin/sh
  mise exec -- just -g run-git-hook $(basename $0) \"$@\"
'''

add-git-hook hook:
    printf %s "$GIT_HOOK_SCRIPT" > {{ git_hook_dir }}/{{ hook }}
    chmod +x {{ git_hook_dir }}/{{ hook }}

@run-git-hook hook *args:
    mise exec -- just -g run-local-git-hook {{ hook }} "{{ args }}"
    mise exec -- just -g git-{{ hook }}-hook "{{ args }}"

@run-local-git-hook hook *args:
    if [ -f "{{ git_hook_dir }}/{{ hook }}" ]; then "{{ git_hook_dir }}/{{ hook }}" {{ args }} || exit 1; fi

@git-commit-msg-hook file:
    mise exec -- cog verify --file {{ file }}

@git-pre-push-hook name url:
    mise exec -- cog check --from-latest-tag
